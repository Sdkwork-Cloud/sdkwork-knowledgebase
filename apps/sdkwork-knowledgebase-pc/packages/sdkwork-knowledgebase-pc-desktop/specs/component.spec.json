{
  "schemaVersion": 1,
  "kind": "sdkwork.component.spec",
  "component": {
    "name": "sdkwork-knowledgebase-pc-desktop",
    "displayName": "SDKWork Knowledgebase PC Desktop Host",
    "version": "0.1.0",
    "type": "tauri-host",
    "root": "apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-desktop",
    "domain": "intelligence",
    "capability": "pc-desktop",
    "surface": "pc-desktop",
    "languages": [
      "typescript",
      "rust"
    ],
    "generated": false,
    "manifests": [
      "package.json",
      "src-tauri/Cargo.toml",
      "src-tauri/tauri.conf.json"
    ]
  },
  "canonicalSpecs": [
    {
      "file": "CODE_STYLE_SPEC.md",
      "path": "../../../../../sdkwork-specs/CODE_STYLE_SPEC.md",
      "purpose": "Authored code organization, public exports, generated-code boundaries, and verification."
    },
    {
      "file": "NAMING_SPEC.md",
      "path": "../../../../../sdkwork-specs/NAMING_SPEC.md",
      "purpose": "Component, package, domain, capability, and surface naming."
    },
    {
      "file": "MODULE_SPEC.md",
      "path": "../../../../../sdkwork-specs/MODULE_SPEC.md",
      "purpose": "Reusable module public contract and dependency direction."
    },
    {
      "file": "APP_PC_ARCHITECTURE_SPEC.md",
      "path": "../../../../../sdkwork-specs/APP_PC_ARCHITECTURE_SPEC.md",
      "purpose": "PC desktop host package role and renderer reuse boundary."
    },
    {
      "file": "DESKTOP_APP_ARCHITECTURE_SPEC.md",
      "path": "../../../../../sdkwork-specs/DESKTOP_APP_ARCHITECTURE_SPEC.md",
      "purpose": "Tauri/native host, local capability, config, and release boundaries."
    },
    {
      "file": "TYPESCRIPT_CODE_SPEC.md",
      "path": "../../../../../sdkwork-specs/TYPESCRIPT_CODE_SPEC.md",
      "purpose": "TypeScript package exports and source layout."
    },
    {
      "file": "RUST_CODE_SPEC.md",
      "path": "../../../../../sdkwork-specs/RUST_CODE_SPEC.md",
      "purpose": "Tauri Rust host source organization and native-host boundaries."
    }
  ],
  "contracts": {
    "layerRole": "runtime-native-host",
    "publicExports": [
      "."
    ],
    "providedPorts": [
      {
        "name": "knowledgebasePcDesktopHostMetadata",
        "export": "."
      },
      {
        "name": "knowledgebasePcDesktopNativeHost",
        "export": "."
      }
    ],
    "requiredPorts": [],
    "runtimeEntrypoints": [
      "package.json#scripts.dev:desktop",
      "package.json#scripts.build:desktop"
    ],
    "routeManifest": null,
    "sdkClients": [],
    "sdkDependencies": [],
    "dependencyApiExports": [],
    "dependencyApiSurfaces": [],
    "events": [],
    "configKeys": [
      "src-tauri/tauri.conf.json",
      "src-tauri/capabilities/default.json"
    ],
    "hostBoundary": {
      "commandAllowlist": [
        "window_control",
        "fetch_binary_resource",
        "read_local_resource",
        "open_external_url",
        "save_binary_resource",
        "save_export_file",
        "reveal_export_file",
        "open_export_file",
        "locate_export_file",
        "export_document_pdf",
        "sync_desktop_preferences",
        "get_desktop_host_status",
        "get_autostart_enabled",
        "sync_tray_locale",
        "write_secure_session_value",
        "remove_secure_session_value",
        "clear_secure_session_values",
        "read_secure_session_value",
        "take_pending_group_knowledgebase_launch"
      ],
      "contentSecurityPolicySource": "src-tauri/tauri.conf.json#app.security.csp",
      "scriptSourcePolicy": "self-only",
      "remoteResource": {
        "protocols": [
          "https",
          "http"
        ],
        "privateNetworkDenied": true,
        "dnsPinnedPerRedirect": true,
        "maxBytes": 33554432,
        "maxRedirects": 5,
        "timeoutSeconds": 30,
        "maxConcurrentOperations": 2
      },
      "localResource": {
        "sandboxRootsOnly": true,
        "maxBytes": 33554432
      },
      "export": {
        "maxBytes": 67108864,
        "maxConcurrentSaves": 1,
        "maxConcurrentPdfRenders": 1,
        "maxDocumentSourceBytes": 16777216,
        "blockingFileIoOffloaded": true
      },
      "secureStore": {
        "maxKeyBytes": 256,
        "maxValueBytes": 262144,
        "maxTrackedKeys": 512,
        "plaintextSnapshotMigrationOnly": true
      }
    }
  },
  "verification": {
    "commands": [
      "pnpm --dir apps/sdkwork-knowledgebase-pc lint",
      "cargo test --manifest-path apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-desktop/src-tauri/Cargo.toml",
      "cargo fmt --manifest-path apps/sdkwork-knowledgebase-pc/packages/sdkwork-knowledgebase-pc-desktop/src-tauri/Cargo.toml --check"
    ]
  }
}
