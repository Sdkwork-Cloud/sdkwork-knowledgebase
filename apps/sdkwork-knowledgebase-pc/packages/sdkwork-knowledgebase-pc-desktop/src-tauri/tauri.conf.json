{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDKWork Knowledgebase",
  "version": "0.1.0",
  "identifier": "com.sdkwork.sdkwork.knowledgebase.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. run dev",
    "beforeBuildCommand": "pnpm --dir ../.. run build",
    "devUrl": "http://localhost:5184",
    "frontendDist": "../../../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SDKWork Knowledgebase",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; font-src 'self' data:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sdkwork-knowledgebase"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "publisher": "SDKWork",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
