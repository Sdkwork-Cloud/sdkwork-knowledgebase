# sdkwork-knowledgebase docker container build profile (standalone container).
# Hand-written companion to the materialized .env.standalone.* files; used by
# the container pipeline (`pnpm build:container` -> vite build):
#   pnpm --dir apps/sdkwork-knowledgebase-pc exec vite build --mode standalone.docker
#
# The portal is served same-origin by the deployment nginx
# (docker/nginx/testapikb-knowledgebase.conf): VITE_SDKWORK_KNOWLEDGEBASE_
# DEV_SAME_ORIGIN_API=true makes the runtime SDK clients use relative API
# paths (/app/v3/api, /backend/v3/api, /knowledge/v3/api, /internal/v3/api), so
# no absolute API URL is baked into the bundle. The *_HTTP_URL values below
# are fallbacks matching the compose host port (3904 -> container 18081).
VITE_SDKWORK_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_ENVIRONMENT=development
VITE_SDKWORK_RUNTIME_TARGET=browser
VITE_SDKWORK_PROFILE_ID=standalone.docker
VITE_SDKWORK_APPBASE_APP_API_BASE_URL=http://127.0.0.1:3904
VITE_SDKWORK_IAM_APP_API_BASE_URL=http://127.0.0.1:3904
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:3904
VITE_SDKWORK_KNOWLEDGEBASE_DEPLOYMENT_PROFILE=standalone
VITE_SDKWORK_KNOWLEDGEBASE_ENVIRONMENT=development
VITE_SDKWORK_KNOWLEDGEBASE_RUNTIME_TARGET=browser
VITE_SDKWORK_KNOWLEDGEBASE_PROFILE_ID=standalone.docker
VITE_SDKWORK_KNOWLEDGEBASE_CONFIG_PROFILE=dev
VITE_SDKWORK_KNOWLEDGEBASE_BUILD_MODE=docker
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:3904
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_BACKEND_HTTP_URL=http://127.0.0.1:3904
VITE_SDKWORK_KNOWLEDGEBASE_APPLICATION_OPEN_HTTP_URL=http://127.0.0.1:3904
VITE_SDKWORK_KNOWLEDGEBASE_DEV_SAME_ORIGIN_API=true
# No platform api-gateway exists in standalone (APP_RUNTIME_TOPOLOGY_SPEC §6);
# keep the fallback pointing at the local gateway for any stray consumer.
VITE_SDKWORK_KNOWLEDGEBASE_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3904
